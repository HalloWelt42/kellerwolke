# Vorne auf dem Pi: liefert die gebaute Oberfläche aus und reicht Schnittstelle und WebDAV an das Backend weiter,
# nur mit TLS aus der Hausstelle (Zertifikat: tools/zertifikat.sh). Die frühere Adresse ohne TLS leitet nur noch auf
# dieselbe Stelle mit TLS um (308 behält Methode und Inhalt); über sie läuft nichts mehr (KW-4).
# Beim Zugriff per IP steht kein Servername im Handschlag, darum default_sni. Kein HSTS: unter einem Rechnernamen
# würde es alle Ports des Pi auf HTTPS zwingen.
{
	admin off
	auto_https off
	default_sni {$KELLERWOLKE_HAUPTADRESSE}
}

(kellerwolke) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
	# Schnittstelle und WebDAV: strömen in beide Richtungen, nichts wird gepuffert (große Uploads, Ereignisstrom).
	@backend path /api/* /webdav /webdav/*
	handle @backend {
		reverse_proxy 127.0.0.1:{$KELLERWOLKE_BACKEND_PORT} {
			flush_interval -1
		}
	}
	# Oberfläche: gebaute Dateien; Namen unter /assets tragen ihren Inhalt im Namen und dürfen ewig im Cache bleiben.
	handle /assets/* {
		root * /oberflaeche
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /oberflaeche
		header Cache-Control "no-cache"
		try_files {path} /index.html
		encode zstd gzip
		file_server
	}
}

http://:{$KELLERWOLKE_FRONTEND_PORT} {
	redir https://{host}:{$KELLERWOLKE_TLS_PORT}{uri} 308
}

:{$KELLERWOLKE_TLS_PORT} {
	tls /zertifikate/kellerwolke.pem /zertifikate/kellerwolke-schluessel.pem
	import kellerwolke
}
